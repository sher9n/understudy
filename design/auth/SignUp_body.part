<div class="u" data-mode="{{mode}}" style="background: var(--bg); color: var(--ink);">
  <div class="authsplit">
    <aside class="pitch">
      <div class="brand">Understudy</div>
      <div class="pitchmid">
        <div class="pitchtext">
          <h1 class="pitch-h">Your LLM stack should keep getting better</h1>
        </div>
        <div class="exhibit"><svg viewBox="0 0 480 192" width="100%" role="img" aria-label="Cost falling along a curve from one hundred and twenty dollars today to forty, twelve and five, noted as quality holding at every step."><path d="M60 62 C104 62 134 91 172 100 C212 110 240 123 276 130 C312 136 348 143 378 146 L378 160 L60 160 Z" fill="var(--ok)" opacity="0.10"></path><path d="M60 62 C104 62 134 91 172 100 C212 110 240 123 276 130 C312 136 348 143 378 146" fill="none" stroke="var(--ok)" stroke-width="2.6" stroke-linecap="round"></path><path d="M394 146 H424" fill="none" stroke="var(--ok)" stroke-width="2.4" opacity="0.45" stroke-linecap="round"></path><path d="M419 141 l5 5 -5 5" fill="none" stroke="var(--ok)" stroke-width="2.4" opacity="0.45" stroke-linecap="round" stroke-linejoin="round"></path><circle cx="60" cy="62" r="9" fill="var(--mut)" opacity="1.0"></circle><circle cx="60" cy="62" r="3.6" fill="var(--raise)"></circle><text x="60" y="41" text-anchor="middle" font-size="16" font-weight="700" fill="var(--ink)">$120</text><circle cx="172" cy="100" r="9" fill="var(--ok)" opacity="0.45"></circle><circle cx="172" cy="100" r="3.6" fill="var(--raise)"></circle><text x="172" y="79" text-anchor="middle" font-size="15" font-weight="700" fill="var(--ink)">$40</text><circle cx="276" cy="130" r="9" fill="var(--ok)" opacity="0.72"></circle><circle cx="276" cy="130" r="3.6" fill="var(--raise)"></circle><text x="276" y="109" text-anchor="middle" font-size="14.5" font-weight="700" fill="var(--ink)">$12</text><circle cx="378" cy="146" r="10" fill="var(--ok)" opacity="1.0"></circle><circle cx="378" cy="146" r="3.6" fill="var(--raise)"></circle><text x="378" y="124" text-anchor="middle" font-size="14.5" font-weight="700" fill="var(--ok)">$5</text><line x1="30" y1="160" x2="452" y2="160" stroke="var(--line)" stroke-width="1.6"></line><text x="32" y="181" font-size="13.5" fill="var(--mut)">Today</text><text x="452" y="181" text-anchor="end" font-size="13.5" fill="var(--mut)">Continuously gets better &#8594;</text><circle cx="256" cy="16" r="9" fill="var(--ok)"></circle><path d="M252 16 L254.6 18.7 L260.3 12.8" fill="none" stroke="var(--onbrand)" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"></path><text x="452" y="21" text-anchor="end" font-size="13" font-weight="600" fill="var(--ink)">Quality holds at every step</text></svg></div>
        <ul class="pts">
          <li><svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true" style="flex: 0 0 auto;"><circle cx="8" cy="8" r="8" fill="var(--okq)"></circle><path d="M4.7 8.2 L6.9 10.4 L11.3 5.7" stroke="var(--ok)" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"></path></svg><span>No manual benchmarking</span></li>
          <li><svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true" style="flex: 0 0 auto;"><circle cx="8" cy="8" r="8" fill="var(--okq)"></circle><path d="M4.7 8.2 L6.9 10.4 L11.3 5.7" stroke="var(--ok)" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"></path></svg><span>Same quality bar</span></li>
          <li><svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true" style="flex: 0 0 auto;"><circle cx="8" cy="8" r="8" fill="var(--okq)"></circle><path d="M4.7 8.2 L6.9 10.4 L11.3 5.7" stroke="var(--ok)" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"></path></svg><span>Up to 24x lower cost</span></li>
        </ul>
      </div>
    </aside>
    <main class="formside">
      <div class="toprow"><a href="#">Sign in</a><button class="ni" style="width: auto;" onClick="{{toggleTheme}}" aria-label="{{switchLabel}}">
      <sc-if value="{{dark}}" hint-placeholder-val="{{true}}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5L19 19M19 5l-1.5 1.5M6.5 17.5L5 19"></path>
        </svg>
      </sc-if>
      <sc-if value="{{light}}" hint-placeholder-val="{{true}}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path d="M21 13a8.5 8.5 0 01-10-10 8.5 8.5 0 1010 10z"></path>
        </svg>
      </sc-if>
    </button></div>
      <form class="authcard">
        <h1>Create your account</h1>
        <p class="sub">Your workspace and its API key are issued together.</p>
        <div class="fields">
          <div>
            <div class="fl"><label for="name">Your name</label></div>
            <input class="field" id="name" type="text" placeholder="Ada Lovelace" autocomplete="name">
          </div>
          <div>
            <div class="fl"><label for="email">Email</label></div>
            <input class="field" id="email" type="email" placeholder="you@company.com" autocomplete="email">
          </div>
          <div>
            <div class="fl"><label for="password">Password</label></div>
            <input class="field" id="password" type="password" placeholder="At least 8 characters" autocomplete="new-password">
          </div>
          <button type="submit" class="btn full">Create account</button>
        </div>
        <p class="fineprint">No card needed to start. Your first calls run on starter credit, and you add a card only when you want us to keep routing.</p>
        <p class="authfoot">Already have an account? <a href="#">Sign in</a>.</p>
      </form>
    </main>
  </div>
