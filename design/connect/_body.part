<div class="u" data-mode="{{mode}}" style="background: var(--bg); color: var(--ink); min-height: 1120px; display: flex; flex-direction: column;">
  <header class="top2"><span class="wm">Understudy</span><div style="flex-grow: 1;"></div>
    <button class="ni" style="width: auto;" onClick="{{toggleTheme}}" aria-label="{{switchLabel}}">
      <sc-if value="{{dark}}" hint-placeholder-val="{{true}}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5L19 19M19 5l-1.5 1.5M6.5 17.5L5 19"></path>
        </svg>
      </sc-if>
      <sc-if value="{{light}}" hint-placeholder-val="{{true}}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path d="M21 13a8.5 8.5 0 01-10-10 8.5 8.5 0 1010 10z"></path>
        </svg>
      </sc-if>
    </button><span class="av">S</span></header>
  <div class="wiz">
    <aside class="rail">
      <div class="m eyeb">Get started</div>
      <div class="railsub">You are three steps from your first measurement.</div>
      <div class="{{s1Cls}}"><span class="n">1</span><div><div class="t">Connect your traffic</div><div class="b">Route through us, or send copies</div></div></div>
      <div class="{{s2Cls}}"><span class="n">2</span><div><div class="t">Send us a call</div><div class="b">One is enough to start</div></div></div>
      <div class="{{s3Cls}}"><span class="n">3</span><div><div class="t">You are connected</div><div class="b">We take it from here</div></div></div>
      <div class="railfoot">Routed calls only reach providers with zero data retention. Stored calls are deleted after 30 days.</div>
    </aside>
    <main class="wizmain">
    <sc-if value="{{isStep1}}" hint-placeholder-val="{{true}}">
      <h1>Connect your traffic</h1>
      <p class="lead">Change one line in the client you already use. You can change your mind later.</p>
      <div class="ways">
        <button class="{{routeCls}}" onClick="{{pick_route}}"><span class="m tag">one click to switch</span><div class="t">Route through us</div><div class="b">Change the base URL in the client you already use. Switching a model later is one click, with no deploy.</div></button>
        <button class="{{copyCls}}" onClick="{{pick_copy}}"><span class="m tag">stay direct</span><div class="t">Send us copies</div><div class="b">Keep calling your own provider. Send us the request and the answer afterwards.</div></button>
      </div>
      <div class="codebox">
        <div class="tabs">
          <button class="{{tab_python}}" onClick="{{pick_python}}">Python</button>
          <button class="{{tab_node}}" onClick="{{pick_node}}">Node.js</button>
          <button class="{{tab_curl}}" onClick="{{pick_curl}}">cURL</button>
          <button class="{{tab_claude}}" onClick="{{pick_claude}}">Instruct your Claude</button>
          <div style="flex-grow: 1;"></div>
          <button class="ghost" style="padding: 5px 10px; font-size: 12px;">Copy</button>
        </div>
        <sc-if value="{{is_route_python}}" hint-placeholder-val="{{true}}"><pre class="m code"><span style="display: block; color: var(--ink);">from openai import OpenAI</span><span style="display: block; height: 1.85em;"></span><span style="display: block; color: var(--ink);">client = OpenAI(</span><span style="display: block;"><span style="display: inline-block; background: var(--okq); color: var(--ok); border-radius: 4px; padding: 0 6px; font-weight: 600;">    base_url="https://api.understudy.dev/v1",</span></span><span style="display: block;"><span style="display: inline-block; background: var(--okq); color: var(--ok); border-radius: 4px; padding: 0 6px; font-weight: 600;">    api_key="us_live_3f9c2a71b84e05d6c1af7be209438d5c",</span></span><span style="display: block; color: var(--ink);">)</span><span style="display: block; height: 1.85em;"></span><span style="display: block; color: var(--ink);">client.chat.completions.create(</span><span style="display: block; color: var(--ink);">    model="openai/gpt-5.4",</span><span style="display: block; color: var(--ink);">    messages=[{"role": "user", "content": "Extract the line items."}],</span><span style="display: block; color: var(--ink);">)</span></pre></sc-if>
        <sc-if value="{{is_route_node}}" hint-placeholder-val="{{true}}"><pre class="m code"><span style="display: block; color: var(--ink);">import OpenAI from "openai";</span><span style="display: block; height: 1.85em;"></span><span style="display: block; color: var(--ink);">const client = new OpenAI({</span><span style="display: block;"><span style="display: inline-block; background: var(--okq); color: var(--ok); border-radius: 4px; padding: 0 6px; font-weight: 600;">  baseURL: "https://api.understudy.dev/v1",</span></span><span style="display: block;"><span style="display: inline-block; background: var(--okq); color: var(--ok); border-radius: 4px; padding: 0 6px; font-weight: 600;">  apiKey: "us_live_3f9c2a71b84e05d6c1af7be209438d5c",</span></span><span style="display: block; color: var(--ink);">});</span><span style="display: block; height: 1.85em;"></span><span style="display: block; color: var(--ink);">await client.chat.completions.create({</span><span style="display: block; color: var(--ink);">  model: "openai/gpt-5.4",</span><span style="display: block; color: var(--ink);">  messages: [{ role: "user", content: "Extract the line items." }],</span><span style="display: block; color: var(--ink);">});</span></pre></sc-if>
        <sc-if value="{{is_route_curl}}" hint-placeholder-val="{{true}}"><pre class="m code"><span style="display: block;"><span style="display: inline-block; background: var(--okq); color: var(--ok); border-radius: 4px; padding: 0 6px; font-weight: 600;">curl https://api.understudy.dev/v1/chat/completions \</span></span><span style="display: block;"><span style="display: inline-block; background: var(--okq); color: var(--ok); border-radius: 4px; padding: 0 6px; font-weight: 600;">  -H "Authorization: Bearer us_live_3f9c2a71b84e05d6c1af7be209438d5c" \</span></span><span style="display: block; color: var(--ink);">  -H "Content-Type: application/json" \</span><span style="display: block; color: var(--ink);">  -d '{</span><span style="display: block; color: var(--ink);">    "model": "openai/gpt-5.4",</span><span style="display: block; color: var(--ink);">    "messages": [{"role": "user", "content": "Extract the line items."}]</span><span style="display: block; color: var(--ink);">  }'</span></pre></sc-if>
        <sc-if value="{{is_route_claude}}" hint-placeholder-val="{{true}}"><pre class="m code"><span style="display: block; color: var(--ink);">Point our OpenAI client at Understudy.</span><span style="display: block; height: 1.85em;"></span><span style="display: block; color: var(--ink);">Change only the base URL to https://api.understudy.dev/v1 and read the key</span><span style="display: block; color: var(--ink);">from UNDERSTUDY_KEY in the environment. Leave every model argument exactly</span><span style="display: block; color: var(--ink);">as it is: Understudy substitutes the model itself once a cheaper one has</span><span style="display: block; color: var(--ink);">proved it answers the same, so a hardcoded override would undo the whole</span><span style="display: block; color: var(--ink);">point of it.</span><span style="display: block; height: 1.85em;"></span><span style="display: block; color: var(--ink);">Do not touch any other call site, and do not add retry or fallback logic.</span><span style="display: block; color: var(--ink);">Streaming, tools and response_format all pass through unchanged.</span></pre></sc-if>
        <sc-if value="{{is_copy_python}}" hint-placeholder-val="{{true}}"><pre class="m code"><span style="display: block; color: var(--ink);">import time, requests</span><span style="display: block; height: 1.85em;"></span><span style="display: block; color: var(--ink);">started = time.time()</span><span style="display: block; color: var(--ink);">answer = your_provider.chat.completions.create(**payload)</span><span style="display: block; height: 1.85em;"></span><span style="display: block; color: var(--ink);">requests.post(</span><span style="display: block;"><span style="display: inline-block; background: var(--okq); color: var(--ok); border-radius: 4px; padding: 0 6px; font-weight: 600;">    "https://api.understudy.dev/v1/traces",</span></span><span style="display: block;"><span style="display: inline-block; background: var(--okq); color: var(--ok); border-radius: 4px; padding: 0 6px; font-weight: 600;">    headers={"Authorization": "Bearer us_live_3f9c2a71b84e05d6c1af7be209438d5c"},</span></span><span style="display: block; color: var(--ink);">    json={</span><span style="display: block; color: var(--ink);">        "request": payload,</span><span style="display: block; color: var(--ink);">        "response": answer.model_dump(),</span><span style="display: block; color: var(--ink);">        "latency_ms": int((time.time() - started) * 1000),</span><span style="display: block; color: var(--ink);">    },</span><span style="display: block; color: var(--ink);">)</span></pre></sc-if>
        <sc-if value="{{is_copy_node}}" hint-placeholder-val="{{true}}"><pre class="m code"><span style="display: block; color: var(--ink);">const started = Date.now();</span><span style="display: block; color: var(--ink);">const answer = await yourProvider.chat.completions.create(payload);</span><span style="display: block; height: 1.85em;"></span><span style="display: block;"><span style="display: inline-block; background: var(--okq); color: var(--ok); border-radius: 4px; padding: 0 6px; font-weight: 600;">await fetch("https://api.understudy.dev/v1/traces", {</span></span><span style="display: block; color: var(--ink);">  method: "POST",</span><span style="display: block; color: var(--ink);">  headers: {</span><span style="display: block;"><span style="display: inline-block; background: var(--okq); color: var(--ok); border-radius: 4px; padding: 0 6px; font-weight: 600;">    Authorization: "Bearer us_live_3f9c2a71b84e05d6c1af7be209438d5c",</span></span><span style="display: block; color: var(--ink);">    "Content-Type": "application/json",</span><span style="display: block; color: var(--ink);">  },</span><span style="display: block; color: var(--ink);">  body: JSON.stringify({</span><span style="display: block; color: var(--ink);">    request: payload,</span><span style="display: block; color: var(--ink);">    response: answer,</span><span style="display: block; color: var(--ink);">    latency_ms: Date.now() - started,</span><span style="display: block; color: var(--ink);">  }),</span><span style="display: block; color: var(--ink);">});</span></pre></sc-if>
        <sc-if value="{{is_copy_curl}}" hint-placeholder-val="{{true}}"><pre class="m code"><span style="display: block;"><span style="display: inline-block; background: var(--okq); color: var(--ok); border-radius: 4px; padding: 0 6px; font-weight: 600;">curl https://api.understudy.dev/v1/traces \</span></span><span style="display: block;"><span style="display: inline-block; background: var(--okq); color: var(--ok); border-radius: 4px; padding: 0 6px; font-weight: 600;">  -H "Authorization: Bearer us_live_3f9c2a71b84e05d6c1af7be209438d5c" \</span></span><span style="display: block; color: var(--ink);">  -H "Content-Type: application/json" \</span><span style="display: block; color: var(--ink);">  -d '{</span><span style="display: block; color: var(--ink);">    "request":  { "model": "openai/gpt-5.4", "messages": [ ... ] },</span><span style="display: block; color: var(--ink);">    "response": { "model": "openai/gpt-5.4", "choices": [ ... ],</span><span style="display: block; color: var(--ink);">                  "usage": { "prompt_tokens": 812, "completion_tokens": 96 } },</span><span style="display: block; color: var(--ink);">    "latency_ms": 1840</span><span style="display: block; color: var(--ink);">  }'</span><span style="display: block; height: 1.85em;"></span><span style="display: block; color: var(--mut);"># up to 200 at a time as { "traces": [ ... ] }</span></pre></sc-if>
        <sc-if value="{{is_copy_claude}}" hint-placeholder-val="{{true}}"><pre class="m code"><span style="display: block; color: var(--ink);">After every LLM call in our codebase, post a copy to Understudy.</span><span style="display: block; height: 1.85em;"></span><span style="display: block; color: var(--ink);">POST https://api.understudy.dev/v1/traces with the header</span><span style="display: block; color: var(--ink);">Authorization: Bearer $UNDERSTUDY_KEY and a JSON body of</span><span style="display: block; color: var(--ink);">{ "request": the exact request object we sent, "response": the exact</span><span style="display: block; color: var(--ink);">response object we got back, "latency_ms": milliseconds }.</span><span style="display: block; height: 1.85em;"></span><span style="display: block; color: var(--ink);">Send it after the answer has gone back to the caller, never before, and</span><span style="display: block; color: var(--ink);">never let a failed post fail the original call. If we already queue work,</span><span style="display: block; color: var(--ink);">batch up to 200 at a time as { "traces": [ ... ] }.</span></pre></sc-if>
      </div>
      <div class="keyrow"><span class="m eyeb">Your key</span><code class="keyval">us_live_3f9c2a71b84e05d6c1af7be209438d5c</code>
        <button class="ghost">Copy</button><div style="flex-grow: 1;"></div>
        <span class="m" style="font-size: 11.5px; color: var(--mut);">{{keyState}}</span></div>
      <div class="wizcta"><button class="btn big" onClick="{{next}}">Next</button>
        <span class="plainb" onClick="{{next}}">I have already connected</span></div>
    </sc-if>
    <sc-if value="{{isStep2}}" hint-placeholder-val="{{true}}">
      <h1>Send us a call</h1>
      <p class="lead">One call is enough to start. We group it by the job it does, with nothing for you to label.</p>
      <div class="codebox"><div class="tabs"><span class="tab on">Try it now</span>
        <div style="flex-grow: 1;"></div>
        <button class="ghost" style="padding: 5px 10px; font-size: 12px;">Copy</button></div>
        <sc-if value="{{is_route}}" hint-placeholder-val="{{true}}"><pre class="m code"><span style="display: block;"><span style="display: inline-block; background: var(--okq); color: var(--ok); border-radius: 4px; padding: 0 6px; font-weight: 600;">curl https://api.understudy.dev/v1/chat/completions \</span></span><span style="display: block;"><span style="display: inline-block; background: var(--okq); color: var(--ok); border-radius: 4px; padding: 0 6px; font-weight: 600;">  -H "Authorization: Bearer us_live_3f9c2a71b84e05d6c1af7be209438d5c" \</span></span><span style="display: block; color: var(--ink);">  -H "Content-Type: application/json" \</span><span style="display: block; color: var(--ink);">  -d '{</span><span style="display: block; color: var(--ink);">    "model": "openai/gpt-5.4",</span><span style="display: block; color: var(--ink);">    "messages": [{"role": "user", "content": "Extract the line items."}]</span><span style="display: block; color: var(--ink);">  }'</span></pre></sc-if>
        <sc-if value="{{is_copy}}" hint-placeholder-val="{{true}}"><pre class="m code"><span style="display: block;"><span style="display: inline-block; background: var(--okq); color: var(--ok); border-radius: 4px; padding: 0 6px; font-weight: 600;">curl https://api.understudy.dev/v1/traces \</span></span><span style="display: block;"><span style="display: inline-block; background: var(--okq); color: var(--ok); border-radius: 4px; padding: 0 6px; font-weight: 600;">  -H "Authorization: Bearer us_live_3f9c2a71b84e05d6c1af7be209438d5c" \</span></span><span style="display: block; color: var(--ink);">  -H "Content-Type: application/json" \</span><span style="display: block; color: var(--ink);">  -d '{</span><span style="display: block; color: var(--ink);">    "request":  { "model": "openai/gpt-5.4", "messages": [ ... ] },</span><span style="display: block; color: var(--ink);">    "response": { "model": "openai/gpt-5.4", "choices": [ ... ],</span><span style="display: block; color: var(--ink);">                  "usage": { "prompt_tokens": 812, "completion_tokens": 96 } },</span><span style="display: block; color: var(--ink);">    "latency_ms": 1840</span><span style="display: block; color: var(--ink);">  }'</span><span style="display: block; height: 1.85em;"></span><span style="display: block; color: var(--mut);"># up to 200 at a time as { "traces": [ ... ] }</span></pre></sc-if>
      </div>
      <sc-if value="{{noCalls}}" hint-placeholder-val="{{true}}">
        <div class="waitbox" onClick="{{arrive}}"><span style="width: 11px; height: 11px; border-radius: 50%; background: var(--line-strong); flex: 0 0 auto;"></span>
          <div><div class="t">Waiting for your first call</div><div class="b">This finishes by itself the moment one arrives.</div></div></div>
      </sc-if>
      <sc-if value="{{hasCalls}}" hint-placeholder-val="{{true}}">
        <div class="inbox">
          <div class="inhead"><svg width="26" height="26" viewBox="0 0 16 16" fill="none" aria-hidden="true" style="flex: 0 0 auto;"><circle cx="8" cy="8" r="8" fill="var(--okq)"></circle><path d="M4.7 8.2 L6.9 10.4 L11.3 5.7" stroke="var(--ok)" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"></path></svg><div><div class="t">You are connected</div><div class="b">17 calls in, grouped into 2 workloads by the job they do. Nothing here was labelled by you.</div></div></div>
          <div class="wrow"><span class="nm">invoice-extract</span><span class="md">openai/gpt-5.4</span><span class="ct">12 calls</span></div>
          <div class="wrow"><span class="nm">support-reply</span><span class="md">openai/gpt-5.4</span><span class="ct">5 calls</span></div>
          <div class="inft"><a href="#" class="btn big">Go to your dashboard</a><span style="font-size: 13px; color: var(--mut);">Measuring starts on its own.</span></div>
        </div>
      </sc-if>
      <div class="wizcta"><span class="plainb" onClick="{{back}}">Back</span></div>
    </sc-if>
    </main>
  </div>
