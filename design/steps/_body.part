<div class="u" data-mode="{{mode}}" style="background: var(--bg); color: var(--ink); min-height: 2260px;">
  <header class="top" style="padding: 20px 44px;">
    <span style="font-weight: 700; font-size: 16px; letter-spacing: -0.03em; color: var(--ink);">Step section</span>
    <span class="m" style="font-size: 11.5px; color: var(--mut); letter-spacing: 0.06em;">THREE WAYS TO NUMBER THE THREE STEPS</span>
    <div style="flex-grow: 1;"></div>
    <button class="ni" style="width: auto;" onClick="{{toggleTheme}}" aria-label="{{switchLabel}}">
      <sc-if value="{{dark}}" hint-placeholder-val="{{true}}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5L19 19M19 5l-1.5 1.5M6.5 17.5L5 19"></path>
        </svg>
      </sc-if>
      <sc-if value="{{light}}" hint-placeholder-val="{{true}}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path d="M21 13a8.5 8.5 0 01-10-10 8.5 8.5 0 1010 10z"></path>
        </svg>
      </sc-if>
    </button>
  </header>
  <div class="sheet">
    <section class="vblock" style="padding-top: 30px;">
      <p style="font-size: 13.5px; color: var(--mut-read); line-height: 1.6; margin: 0; max-width: 88ch;">
        The same three steps, the same three drawings and the same copy in all three. Only the step marker changes. What is
        on the page today is a bare numeral in a blue disc beside the title, which none of these keep.
      </p>
    </section>
    <section class="vblock sA">
      <div class="vhead"><span class="m vtag">A</span><div><div class="vname">The eyebrow</div><div class="vnote">Step 1 sits inside the card, above the title, in the same mono eyebrow the site already uses for Dedicated endpoints and for the steps on the How it works page. The quietest of the three, and the one that adds nothing new to the vocabulary.</div></div></div>
      <h2 class="sec-h2">How it works</h2>
      <div class="three">
      <div class="lp-card">
        <div class="art"><svg viewBox="0 0 370 168" width="100%" role="img" aria-label="Six sample calls on the left flowing through one automatic step into three named jobs on the right: invoice extract, support reply and doc classify."><text x="6" y="14" class="m" font-size="8.5" fill="var(--mut)">incoming calls</text><rect x="6" y="24" width="96" height="30" rx="7" fill="var(--raise)" stroke="var(--line)" stroke-width="1"></rect><rect x="12" y="30" width="18" height="18" rx="5" fill="var(--panel)" stroke="var(--line)" stroke-width="1"></rect><path d="M18.0 35.0 h4.4 l1.9 1.9 v6.6 h-6.3 z" fill="none" stroke="var(--mut)" stroke-width="1.1" stroke-linejoin="round"></path><path d="M19.4 39.0 h3.4 M19.4 41.0 h2.2" stroke="var(--mut)" stroke-width="1"></path><rect x="36" y="33" width="52" height="4.5" rx="2.2" fill="var(--line-strong)"></rect><rect x="36" y="42" width="34" height="4.5" rx="2.2" fill="var(--line-strong)" opacity="0.6"></rect><rect x="6" y="58" width="96" height="30" rx="7" fill="var(--raise)" stroke="var(--line)" stroke-width="1"></rect><rect x="12" y="64" width="18" height="18" rx="5" fill="var(--panel)" stroke="var(--line)" stroke-width="1"></rect><path d="M16.8 69.6 h8.4 v5.6 h-4.6 l-2.4 2.1 v-2.1 h-1.4 z" fill="none" stroke="var(--mut)" stroke-width="1.1" stroke-linejoin="round"></path><rect x="36" y="67" width="52" height="4.5" rx="2.2" fill="var(--line-strong)"></rect><rect x="36" y="76" width="34" height="4.5" rx="2.2" fill="var(--line-strong)" opacity="0.6"></rect><rect x="6" y="92" width="96" height="30" rx="7" fill="var(--raise)" stroke="var(--line)" stroke-width="1"></rect><rect x="12" y="98" width="18" height="18" rx="5" fill="var(--panel)" stroke="var(--line)" stroke-width="1"></rect><path d="M19.4 104.0 l-2.6 3.1 2.6 3.1 M22.8 104.0 l2.6 3.1 -2.6 3.1" fill="none" stroke="var(--mut)" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"></path><rect x="36" y="101" width="52" height="4.5" rx="2.2" fill="var(--line-strong)"></rect><rect x="36" y="110" width="34" height="4.5" rx="2.2" fill="var(--line-strong)" opacity="0.6"></rect><rect x="6" y="126" width="96" height="30" rx="7" fill="var(--raise)" stroke="var(--line)" stroke-width="1"></rect><rect x="12" y="132" width="18" height="18" rx="5" fill="var(--panel)" stroke="var(--line)" stroke-width="1"></rect><rect x="16.7" y="137.8" width="8.6" height="6.4" rx="1.2" fill="none" stroke="var(--mut)" stroke-width="1.1"></rect><path d="M17.1 138.6 L21.0 141.6 L24.9 138.6" fill="none" stroke="var(--mut)" stroke-width="1.1" stroke-linejoin="round"></path><rect x="36" y="135" width="52" height="4.5" rx="2.2" fill="var(--line-strong)"></rect><rect x="36" y="144" width="34" height="4.5" rx="2.2" fill="var(--line-strong)" opacity="0.6"></rect><g stroke="var(--line-strong)" stroke-width="1.1" fill="none" stroke-dasharray="3 3"><path d="M104 39 C116 39 114 93 126 93"></path><path d="M104 73 C116 73 114 93 126 93"></path><path d="M104 107 C116 107 114 93 126 93"></path><path d="M104 141 C116 141 114 93 126 93"></path></g><path d="M150 41 Q151.4 46.6 157 48 Q151.4 49.4 150 55 Q148.6 49.4 143 48 Q148.6 46.6 150 41 Z" fill="var(--brand)"></path><path d="M159 38 Q159.8 41.2 163 42 Q159.8 42.8 159 46 Q158.2 42.8 155 42 Q158.2 41.2 159 38 Z" fill="var(--brand)" opacity="0.65"></path><text x="150" y="66" text-anchor="middle" class="m" font-size="8.5" fill="var(--mut)">automatic</text><circle cx="150" cy="93" r="22" fill="var(--raise)" stroke="var(--line)" stroke-width="1.3"></circle><path d="M139 84 L161 84 L152.5 94.5 L152.5 103 L147.5 100 L147.5 94.5 Z" fill="var(--mut)"></path><text x="150" y="141" text-anchor="middle" class="m" font-size="8.5" fill="var(--mut)">grouped by job</text><path d="M165 78 C186 68 196 50 212 50" fill="none" stroke="var(--brand)" stroke-width="1.6"></path><path d="M207 46 l5 4 -5 4" fill="none" stroke="var(--brand)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path><rect x="217" y="35" width="147" height="30" rx="8" fill="var(--brandq)"></rect><circle cx="230" cy="50" r="3.5" fill="var(--brand)"></circle><circle cx="240" cy="50" r="3.5" fill="var(--brand)"></circle><circle cx="250" cy="50" r="3.5" fill="var(--brand)"></circle><circle cx="260" cy="50" r="3.5" fill="var(--brand)"></circle><text x="273" y="53" class="m" font-size="8" font-weight="600" fill="var(--brand)">invoice-extract</text><path d="M172 93 H212" fill="none" stroke="var(--ok)" stroke-width="1.6"></path><path d="M207 89 l5 4 -5 4" fill="none" stroke="var(--ok)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path><rect x="217" y="78" width="147" height="30" rx="8" fill="var(--okq)"></rect><circle cx="230" cy="93" r="3.5" fill="var(--ok)"></circle><circle cx="240" cy="93" r="3.5" fill="var(--ok)"></circle><circle cx="250" cy="93" r="3.5" fill="var(--ok)"></circle><circle cx="260" cy="93" r="3.5" fill="var(--ok)"></circle><text x="273" y="96" class="m" font-size="8" font-weight="600" fill="var(--ok)">support-reply</text><path d="M160 112 C182 122 196 136 212 136" fill="none" stroke="var(--warn)" stroke-width="1.6"></path><path d="M207 132 l5 4 -5 4" fill="none" stroke="var(--warn)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path><rect x="217" y="121" width="147" height="30" rx="8" fill="var(--warnq)"></rect><circle cx="230" cy="136" r="3.5" fill="var(--warn)"></circle><circle cx="240" cy="136" r="3.5" fill="var(--warn)"></circle><circle cx="250" cy="136" r="3.5" fill="var(--warn)"></circle><text x="273" y="139" class="m" font-size="8" font-weight="600" fill="var(--warn)">doc-classify</text></svg></div>
        <div class="body">
            <div class="ek">Step 1</div>
          <div class="t">Connect your traffic</div>
          <div class="b">Route calls through us or send us request and response pairs. We automatically group your calls by the job they are doing.</div>
        </div>
      </div>
      <div class="lp-card">
        <div class="art"><svg viewBox="0 0 370 168" width="100%" role="img" aria-label="Sampled calls from one job priced on four models, the cheapest one that clears the quality bar marked chosen, and what you run today at the bottom for scale."><text x="250" y="15" text-anchor="end" class="m" font-size="7" fill="var(--mut)">COST</text><text x="280" y="15" class="m" font-size="7" fill="var(--mut)">QUALITY BAR</text><line x1="256" y1="20" x2="256" y2="150" stroke="var(--line-strong)" stroke-width="1" stroke-dasharray="4 4"></line><rect x="6" y="26" width="96" height="92" rx="9" fill="var(--raise)" stroke="var(--line)" stroke-width="1.2"></rect><text x="54" y="42" text-anchor="middle" class="m" font-size="8.5" font-weight="600" fill="var(--ink)">invoice-extract</text><rect x="14" y="50" width="76" height="9" rx="4.5" fill="var(--brandq)"></rect><circle cx="20" cy="54.5" r="2.8" fill="var(--brand)"></circle><rect x="14" y="62" width="76" height="9" rx="4.5" fill="var(--brandq)"></rect><circle cx="20" cy="66.5" r="2.8" fill="var(--brand)"></circle><rect x="14" y="74" width="76" height="9" rx="4.5" fill="var(--brandq)"></rect><circle cx="20" cy="78.5" r="2.8" fill="var(--brand)"></circle><rect x="14" y="86" width="76" height="9" rx="4.5" fill="var(--brandq)"></rect><circle cx="20" cy="90.5" r="2.8" fill="var(--brand)"></circle><rect x="14" y="98" width="76" height="9" rx="4.5" fill="var(--brandq)"></rect><circle cx="20" cy="102.5" r="2.8" fill="var(--brand)"></circle><text x="54" y="131" text-anchor="middle" class="m" font-size="8" fill="var(--mut)">sampled calls</text><path d="M104 60 C118 60 114 37 126 37" fill="none" stroke="var(--bad)" stroke-width="1.5"></path><path d="M104 68 C118 68 114 69 126 69" fill="none" stroke="var(--ok)" stroke-width="1.5"></path><path d="M104 80 C118 80 114 101 126 101" fill="none" stroke="var(--brand)" stroke-width="1.5"></path><path d="M104 92 C118 92 114 133 126 133" fill="none" stroke="var(--line-strong)" stroke-width="1.5" stroke-dasharray="4 3"></path><rect x="128" y="24" width="236" height="26" rx="7" fill="var(--badq)" stroke="var(--bad)" stroke-width="1.2"></rect><text x="138" y="40" class="m" font-size="8.5" fill="var(--bad)">flash-lite</text><text x="250" y="40" text-anchor="end" class="m" font-size="8.5" fill="var(--bad)">$3</text><circle cx="268" cy="37" r="6" fill="var(--bad)"></circle><path d="M265.8 34.8 L270.2 39.2 M270.2 34.8 L265.8 39.2" stroke="var(--onbrand)" stroke-width="1.5" stroke-linecap="round"></path><text x="280" y="40" class="m" font-size="8" fill="var(--bad)">misses</text><rect x="128" y="56" width="236" height="26" rx="7" fill="var(--okq)" stroke="var(--ok)" stroke-width="1.8"></rect><text x="138" y="72" class="m" font-size="8.5" font-weight="600" fill="var(--ok)">mistral-small</text><text x="250" y="72" text-anchor="end" class="m" font-size="8.5" font-weight="600" fill="var(--ok)">$8</text><circle cx="268" cy="69" r="6" fill="var(--ok)"></circle><path d="M265.4 69 L267.2 71.0 L270.8 66.8" fill="none" stroke="var(--onbrand)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><text x="280" y="72" class="m" font-size="8" fill="var(--ok)">clears</text><rect x="314" y="61" width="42" height="16" rx="8" fill="var(--ok)"></rect><text x="335" y="72" text-anchor="middle" class="m" font-size="7.5" font-weight="600" fill="var(--onbrand)">chosen</text><rect x="128" y="88" width="236" height="26" rx="7" fill="var(--brandq)" stroke="var(--brand)" stroke-width="1.2"></rect><text x="138" y="104" class="m" font-size="8.5" fill="var(--brand)">haiku-4.5</text><text x="250" y="104" text-anchor="end" class="m" font-size="8.5" fill="var(--brand)">$41</text><circle cx="268" cy="101" r="6" fill="var(--ok)"></circle><path d="M265.4 101 L267.2 103.0 L270.8 98.8" fill="none" stroke="var(--onbrand)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><text x="280" y="104" class="m" font-size="8" fill="var(--brand)">clears</text><rect x="128" y="120" width="236" height="26" rx="7" fill="var(--panel)" stroke="var(--line)" stroke-width="1.2"></rect><text x="138" y="136" class="m" font-size="8.5" fill="var(--mut)">what you run now</text><text x="250" y="136" text-anchor="end" class="m" font-size="8.5" fill="var(--mut)">$212</text><path d="M264 133 h8" stroke="var(--mut)" stroke-width="1.5" stroke-linecap="round"></path><text x="280" y="136" class="m" font-size="8" fill="var(--mut)">sets the bar</text><text x="262" y="160" class="m" font-size="7" fill="var(--mut)">higher quality &#8594;</text></svg></div>
        <div class="body">
            <div class="ek">Step 2</div>
          <div class="t">Auto-run randomized trials</div>
          <div class="b">We sample your real traffic, test it across multiple models, and measure accuracy, performance, and cost against your current model.</div>
        </div>
      </div>
      <div class="lp-card">
        <div class="art"><svg viewBox="0 0 370 168" width="100%" role="img" aria-label="Quality held above the bar across five months while cost per month falls from two hundred and twelve dollars to seventy four, with the months a model was re-tested or switched called out."><circle cx="12" cy="8" r="4" fill="var(--brand)"></circle><text x="21" y="11" class="m" font-size="8" fill="var(--mut)">Cost</text><circle cx="60" cy="8" r="4" fill="var(--ok)"></circle><text x="69" y="11" class="m" font-size="8" fill="var(--mut)">Quality</text><path d="M278 8 h22" stroke="var(--ok)" stroke-width="1.6" stroke-dasharray="4 3"></path><text x="306" y="11" class="m" font-size="8" fill="var(--mut)">Quality bar</text><rect x="24.1" y="16" width="51.8" height="16" rx="8" fill="var(--panel)" stroke="var(--line)" stroke-width="1"></rect><text x="50.0" y="27" text-anchor="middle" class="m" font-size="7" fill="var(--mut)">re-tested</text><path d="M50 32 V44" stroke="var(--line-strong)" stroke-width="1" stroke-dasharray="2 2"></path><rect x="157.6" y="16" width="72.8" height="16" rx="8" fill="var(--panel)" stroke="var(--line)" stroke-width="1"></rect><text x="194.0" y="27" text-anchor="middle" class="m" font-size="7" fill="var(--mut)">switched model</text><path d="M194 32 V40" stroke="var(--line-strong)" stroke-width="1" stroke-dasharray="2 2"></path><rect x="312.1" y="16" width="51.8" height="16" rx="8" fill="var(--panel)" stroke="var(--line)" stroke-width="1"></rect><text x="338.0" y="27" text-anchor="middle" class="m" font-size="7" fill="var(--mut)">re-tested</text><path d="M338 32 V42" stroke="var(--line-strong)" stroke-width="1" stroke-dasharray="2 2"></path><path d="M50 52 L122 58 L194 48 L266 60 L338 50 L338 72 L50 72 Z" fill="var(--ok)" opacity="0.10"></path><path d="M50 52 L122 58 L194 48 L266 60 L338 50" fill="none" stroke="var(--ok)" stroke-width="2" stroke-linejoin="round"></path><circle cx="50" cy="52" r="7" fill="var(--ok)"></circle><path d="M47.0 52 L48.9 54.1 L53.2 49.6" fill="none" stroke="var(--onbrand)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path><circle cx="122" cy="58" r="7" fill="var(--ok)"></circle><path d="M119.0 58 L120.9 60.1 L125.2 55.6" fill="none" stroke="var(--onbrand)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path><circle cx="194" cy="48" r="7" fill="var(--ok)"></circle><path d="M191.0 48 L192.9 50.1 L197.2 45.6" fill="none" stroke="var(--onbrand)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path><circle cx="266" cy="60" r="7" fill="var(--ok)"></circle><path d="M263.0 60 L264.9 62.1 L269.2 57.6" fill="none" stroke="var(--onbrand)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path><circle cx="338" cy="50" r="7" fill="var(--ok)"></circle><path d="M335.0 50 L336.9 52.1 L341.2 47.6" fill="none" stroke="var(--onbrand)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path><line x1="10" y1="72" x2="360" y2="72" stroke="var(--ok)" stroke-width="1.5" stroke-dasharray="5 4"></line><rect x="28" y="92.0" width="44" height="58.0" rx="5" fill="var(--brand)"></rect><text x="50" y="87.0" text-anchor="middle" class="m" font-size="8.5" font-weight="600" fill="var(--brand)">$212</text><rect x="100" y="104.0" width="44" height="46.0" rx="5" fill="var(--brand)"></rect><text x="122" y="99.0" text-anchor="middle" class="m" font-size="8.5" font-weight="600" fill="var(--brand)">$168</text><rect x="172" y="115.5" width="44" height="34.5" rx="5" fill="var(--brand)"></rect><text x="194" y="110.5" text-anchor="middle" class="m" font-size="8.5" font-weight="600" fill="var(--brand)">$126</text><rect x="244" y="124.8" width="44" height="25.2" rx="5" fill="var(--brand)"></rect><text x="266" y="119.8" text-anchor="middle" class="m" font-size="8.5" font-weight="600" fill="var(--brand)">$92</text><rect x="316" y="129.8" width="44" height="20.2" rx="5" fill="var(--brand)"></rect><text x="338" y="124.80000000000001" text-anchor="middle" class="m" font-size="8.5" font-weight="600" fill="var(--brand)">$74</text><line x1="10" y1="150" x2="360" y2="150" stroke="var(--line)" stroke-width="1.2"></line><text x="50" y="161" text-anchor="middle" class="m" font-size="8" fill="var(--mut)">may</text><text x="122" y="161" text-anchor="middle" class="m" font-size="8" fill="var(--mut)">jun</text><text x="194" y="161" text-anchor="middle" class="m" font-size="8" fill="var(--mut)">jul</text><text x="266" y="161" text-anchor="middle" class="m" font-size="8" fill="var(--mut)">aug</text><text x="338" y="161" text-anchor="middle" class="m" font-size="8" fill="var(--mut)">sep</text></svg></div>
        <div class="body">
            <div class="ek">Step 3</div>
          <div class="t">Continuously optimize</div>
          <div class="b">We keep re-testing as models, quality, and prices change, so your workloads stay on the best fit without manual testing or ongoing tuning on your end.</div>
        </div>
      </div>
      </div>
    </section>
    <section class="vblock sB">
      <div class="vhead"><span class="m vtag">B</span><div><div class="vname">The labelled card</div><div class="vnote">Each card gets its own header band above the drawing, with Step 1 as a tinted tag. Unmissable, and it makes each card read as a numbered panel rather than a feature tile. Costs about forty pixels of card height.</div></div></div>
      <h2 class="sec-h2">How it works</h2>
      <div class="three">
      <div class="lp-card">
        <div class="hdr"><span class="m p">Step 1</span></div>
        <div class="art"><svg viewBox="0 0 370 168" width="100%" role="img" aria-label="Six sample calls on the left flowing through one automatic step into three named jobs on the right: invoice extract, support reply and doc classify."><text x="6" y="14" class="m" font-size="8.5" fill="var(--mut)">incoming calls</text><rect x="6" y="24" width="96" height="30" rx="7" fill="var(--raise)" stroke="var(--line)" stroke-width="1"></rect><rect x="12" y="30" width="18" height="18" rx="5" fill="var(--panel)" stroke="var(--line)" stroke-width="1"></rect><path d="M18.0 35.0 h4.4 l1.9 1.9 v6.6 h-6.3 z" fill="none" stroke="var(--mut)" stroke-width="1.1" stroke-linejoin="round"></path><path d="M19.4 39.0 h3.4 M19.4 41.0 h2.2" stroke="var(--mut)" stroke-width="1"></path><rect x="36" y="33" width="52" height="4.5" rx="2.2" fill="var(--line-strong)"></rect><rect x="36" y="42" width="34" height="4.5" rx="2.2" fill="var(--line-strong)" opacity="0.6"></rect><rect x="6" y="58" width="96" height="30" rx="7" fill="var(--raise)" stroke="var(--line)" stroke-width="1"></rect><rect x="12" y="64" width="18" height="18" rx="5" fill="var(--panel)" stroke="var(--line)" stroke-width="1"></rect><path d="M16.8 69.6 h8.4 v5.6 h-4.6 l-2.4 2.1 v-2.1 h-1.4 z" fill="none" stroke="var(--mut)" stroke-width="1.1" stroke-linejoin="round"></path><rect x="36" y="67" width="52" height="4.5" rx="2.2" fill="var(--line-strong)"></rect><rect x="36" y="76" width="34" height="4.5" rx="2.2" fill="var(--line-strong)" opacity="0.6"></rect><rect x="6" y="92" width="96" height="30" rx="7" fill="var(--raise)" stroke="var(--line)" stroke-width="1"></rect><rect x="12" y="98" width="18" height="18" rx="5" fill="var(--panel)" stroke="var(--line)" stroke-width="1"></rect><path d="M19.4 104.0 l-2.6 3.1 2.6 3.1 M22.8 104.0 l2.6 3.1 -2.6 3.1" fill="none" stroke="var(--mut)" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"></path><rect x="36" y="101" width="52" height="4.5" rx="2.2" fill="var(--line-strong)"></rec