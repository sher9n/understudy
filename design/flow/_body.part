<div class="u" data-mode="{{mode}}" style="background: var(--bg); color: var(--ink); min-height: 840px;">
  <header class="top" style="padding: 20px 48px;">
    <span style="font-weight: 700; font-size: 16px; letter-spacing: -0.03em; color: var(--ink);">What the platform does</span>
    <span class="m" style="font-size: 11.5px; color: var(--mut); letter-spacing: 0.06em;">THREE WAYS TO DRAW THE WHOLE LOOP</span>
    <div style="flex-grow: 1;"></div>
    <button class="ni" style="width: auto;" onClick="{{toggleTheme}}" aria-label="{{switchLabel}}">
      <sc-if value="{{dark}}" hint-placeholder-val="{{true}}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5L19 19M19 5l-1.5 1.5M6.5 17.5L5 19"></path>
        </svg>
      </sc-if>
      <sc-if value="{{light}}" hint-placeholder-val="{{true}}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path d="M21 13a8.5 8.5 0 01-10-10 8.5 8.5 0 1010 10z"></path>
        </svg>
      </sc-if>
    </button>
  </header>
  <div class="sheet">
    <p style="font-size: 13.5px; color: var(--mut-read); line-height: 1.6; margin: 30px 0 0; max-width: 96ch;">
      No real provider is named or drawn. The three candidates carry invented marks and the neutral names Model A,
      B and C, so the picture says what the platform does without picking anybody's side. Each is drawn at the
      width it would render at on the sign in screen.
    </p>
    <div class="grid3">
      <div>
        <div class="vname"><span class="vtag">A</span>The loop</div>
        <div class="vnote">Traffic on the left, Understudy in the middle with the arrow that says it never stops, three candidates judged on the right, and the outcome stated once along the bottom. Closest to the picture you sent.</div>
        <div class="stage"><div class="exhibit"><svg viewBox="0 0 480 278" width="100%" role="img" aria-label="Live requests entering Understudy, three candidate models judged against the quality bar, and the one that clears it serving the traffic."><text x="8" y="14" font-size="9" fill="var(--mut)">your live traffic</text><rect x="8" y="24" width="96" height="34" rx="8" fill="var(--raise)" stroke="var(--line)" stroke-width="1"></rect><rect x="13" y="32" width="17" height="17" rx="5" fill="var(--panel)" stroke="var(--line)" stroke-width="1"></rect><path d="M14.0 29.0 h4 l1.7 1.7 v6 h-5.7 z" fill="none" stroke="var(--mut)" stroke-width="1.1" stroke-linejoin="round" stroke-linecap="round"></path><rect x="38" y="34" width="52" height="4" rx="2" fill="var(--line-strong)"></rect><rect x="38" y="45" width="32" height="4" rx="2" fill="var(--line-strong)" opacity="0.6"></rect><rect x="8" y="68" width="96" height="34" rx="8" fill="var(--raise)" stroke="var(--line)" stroke-width="1"></rect><rect x="13" y="76" width="17" height="17" rx="5" fill="var(--panel)" stroke="var(--line)" stroke-width="1"></rect><path d="M16.4 73.5 l-2.4 2.8 2.4 2.8 M19.6 73.5 l2.4 2.8 -2.4 2.8" fill="none" stroke="var(--mut)" stroke-width="1.1" stroke-linejoin="round" stroke-linecap="round"></path><rect x="38" y="78" width="52" height="4" rx="2" fill="var(--line-strong)"></rect><rect x="38" y="89" width="32" height="4" rx="2" fill="var(--line-strong)" opacity="0.6"></rect><rect x="8" y="112" width="96" height="34" rx="8" fill="var(--raise)" stroke="var(--line)" stroke-width="1"></rect><rect x="13" y="120" width="17" height="17" rx="5" fill="var(--panel)" stroke="var(--line)" stroke-width="1"></rect><path d="M14.2 117.5 h7.6 v5 h-4.2 l-2.2 2 v-2 h-1.2 z" fill="none" stroke="var(--mut)" stroke-width="1.1" stroke-linejoin="round" stroke-linecap="round"></path><rect x="38" y="122" width="52" height="4" rx="2" fill="var(--line-strong)"></rect><rect x="38" y="133" width="32" height="4" rx="2" fill="var(--line-strong)" opacity="0.6"></rect><g stroke="var(--line-strong)" stroke-width="1.2" fill="none" stroke-dasharray="3 3"><path d="M108 41 C122 41 120 118 130 118"></path><path d="M108 85 C122 85 120 118 130 118"></path><path d="M108 129 C122 129 120 118 130 118"></path></g><circle cx="172" cy="118" r="40" fill="var(--raise)" stroke="var(--brand)" stroke-width="1.6"></circle><path d="M172 70 A48 48 0 1 1 128 100" fill="none" stroke="var(--brand)" stroke-width="2" opacity="0.32" stroke-linecap="round"></path><path d="M124 95 l4 6 6 -3" fill="none" stroke="var(--brand)" stroke-width="2" opacity="0.32" stroke-linecap="round" stroke-linejoin="round"></path><text x="172" y="116" text-anchor="middle" font-size="11.5" font-weight="700" fill="var(--brand)">Understudy</text><text x="172" y="131" text-anchor="middle" font-size="7.5" fill="var(--mut)">tests, then switches</text><rect x="240" y="26" width="232" height="48" rx="9" fill="var(--raise)" stroke="var(--line)" stroke-width="1.1"></rect><g stroke="var(--ink)" stroke-width="1.3" fill="none"><circle cx="260.0" cy="50.0" r="5"></circle><path d="M260.0 45.0 v-3.5 M264.0 52.5 l3 2 M256.0 52.5 l-3 2"></path></g><text x="278" y="46" font-size="10.5" font-weight="600" fill="var(--ink)">Model A</text><text x="278" y="60" font-size="8" fill="var(--mut)">frontier</text><circle cx="374" cy="50" r="9" fill="var(--bad)"></circle><path d="M370.8 46.8 L377.2 53.2 M377.2 46.8 L370.8 53.2" stroke="var(--onbrand)" stroke-width="1.8" stroke-linecap="round"></path><text x="390" y="54" font-size="8.5" fill="var(--mut)">misses the bar</text><rect x="240" y="82" width="232" height="48" rx="9" fill="var(--okq)" stroke="var(--ok)" stroke-width="1.6"></rect><g stroke="var(--ink)" stroke-width="1.3" fill="none"><rect x="254.0" y="100.0" width="9" height="9" rx="2.5"></rect><rect x="257.5" y="103.5" width="9" height="9" rx="2.5"></rect></g><text x="278" y="102" font-size="10.5" font-weight="600" fill="var(--ink)">Model B</text><text x="278" y="116" font-size="8" fill="var(--mut)">open weights</text><circle cx="374" cy="106" r="9" fill="var(--ok)"></circle><path d="M370.2 106 L372.7 108.6 L378.1 103.0" fill="none" stroke="var(--onbrand)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path><text x="390" y="110" font-size="8.5" font-weight="600" fill="var(--ok)">clears the bar</text><rect x="240" y="138" width="232" height="48" rx="9" fill="var(--raise)" stroke="var(--line)" stroke-width="1.1"></rect><g stroke="var(--ink)" stroke-width="1.3" fill="none"><path d="M260.0 156.0 L266.0 162.0 L260.0 168.0 L254.0 162.0 Z"></path></g><circle cx="260.0" cy="162.0" r="1.8" fill="var(--ink)"></circle><text x="278" y="158" font-size="10.5" font-weight="600" fill="var(--ink)">Model C</text><text x="278" y="172" font-size="8" fill="var(--mut)">alternative</text><circle cx="374" cy="162" r="9" fill="var(--line-strong)"></circle><text x="374" y="165.5" text-anchor="middle" font-size="10" font-weight="700" fill="var(--raise)">$</text><text x="390" y="166" font-size="8.5" fill="var(--mut)">costs more</text><g fill="none" stroke-width="1.4"><path d="M212 104 C226 96 222 50 234 50" stroke="var(--line-strong)" stroke-dasharray="3 3"></path><path d="M212 118 H234" stroke="var(--ok)" stroke-width="1.8"></path><path d="M212 132 C226 140 222 186 234 186" stroke="var(--line-strong)" stroke-dasharray="3 3"></path></g><rect x="8" y="214" width="464" height="50" rx="11" fill="var(--okq)" stroke="var(--ok)" stroke-width="1.2"></rect><circle cx="34" cy="239" r="11" fill="var(--ok)"></circle><path d="M30.2 239 L32.7 241.6 L38.1 236.0" fill="none" stroke="var(--onbrand)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path><text x="56" y="235" font-size="11.5" font-weight="700" fill="var(--ok)">Model B is serving your traffic</text><text x="56" y="251" font-size="8.5" fill="var(--mut)">no benchmarking, no deploy, and it reverts by itself if quality slips</text></svg></div></div>
      </div>
      <div>
        <div class="vname"><span class="vtag">B</span>Three stages</div>
        <div class="vnote">The same story cut into the three numbered stages, which is how the section on the homepage already reads. The live panel on the right carries the two facts the points below repeat.</div>
        <div class="stage"><div class="exhibit"><svg viewBox="0 0 480 278" width="100%" role="img" aria-label="Three stages side by side: your workload, continuous testing on every candidate, and automatic routing to the cheapest model that clears."><circle cx="19" cy="16" r="11" fill="var(--brandq)"></circle><text x="19" y="20" text-anchor="middle" font-size="11" font-weight="700" fill="var(--brand)">1</text><text x="38" y="20" font-size="11.5" font-weight="700" fill="var(--ink)">Your workload</text><text x="8" y="42" font-size="8.5" fill="var(--mut)">live requests, exactly as they are</text><circle cx="178" cy="16" r="11" fill="var(--brandq)"></circle><text x="178" y="20" text-anchor="middle" font-size="11" font-weight="700" fill="var(--brand)">2</text><text x="197" y="20" font-size="11.5" font-weight="700" fill="var(--ink)">Continuous testing</text><text x="167" y="42" font-size="8.5" fill="var(--mut)">the same calls, on every candidate</text><circle cx="337" cy="16" r="11" fill="var(--brandq)"></circle><text x="337" y="20" text-anchor="middle" font-size="11" font-weight="700" fill="var(--brand)">3</text><text x="356" y="20" font-size="11.5" font-weight="700" fill="var(--ink)">Automatic routing</text><text x="326" y="42" font-size="8.5" fill="var(--mut)">the cheapest one that clears</text><rect x="8" y="60" width="145" height="34" rx="8" fill="var(--raise)" stroke="var(--line)" stroke-width="1"></rect><rect x="13" y="68" width="17" height="17" rx="5" fill="var(--panel)" stroke="var(--line)" stroke-width="1"></rect><path d="M14.0 65.0 h4 l1.7 1.7 v6 h-5.7 z" fill="none" stroke="var(--mut)" stroke-width="1.1" stroke-linejoin="round" stroke-linecap="round"></path><rect x="38" y="70" width="101" height="4" rx="2" fill="var(--line-strong)"></rect><rect x="38" y="81" width="62" height="4" rx="2" fill="var(--line-strong)" opacity="0.6"></rect><rect x="8" y="104" width="145" height="34" rx="8" fill="var(--raise)" stroke="var(--line)" stroke-width="1"></rect><rect x="13" y="112" width="17" height="17" rx="5" fill="var(--panel)" stroke="var(--line)" stroke-width="1"></rect><path d="M16.4 109.5 l-2.4 2.8 2.4 2.8 M19.6 109.5 l2.4 2.8 -2.4 2.8" fill="none" stroke="var(--mut)" stroke-width="1.1" stroke-linejoin="round" stroke-linecap="round"></path><rect x="38" y="114" width="101" height="4" rx="2" fill="var(--line-strong)"></rect><rect x="38" y="125" width="62" height="4" rx="2" fill="var(--line-strong)" opacity="0.6"></rect><rect x="8" y="148" width="145" height="34" rx="8" fill="var(--raise)" stroke="var(--line)" stroke-width="1"></rect><rect x="13" y="156" width="17" height="17" rx="5" fill="var(--panel)" stroke="var(--line)" stroke-width="1"></rect><path d="M14.2 153.5 h7.6 v5 h-4.2 l-2.2 2 v-2 h-1.2 z" fill="none" stroke="var(--mut)" stroke-width="1.1" stroke-linejoin="round" stroke-linecap="round"></path><rect x="38" y="158" width="101" height="4" rx="2" fill="var(--line-strong)"></rect><rect x="38" y="169" width="62" height="4" rx="2" fill="var(--line-strong)" opacity="0.6"></rect><rect x="167" y="60" width="145" height="34" rx="8" fill="var(--raise)" stroke="var(--line)" stroke-width="1"></rect><g stroke="var(--ink)" stroke-width="1.3" fill="none"><circle cx="184.0" cy="77.0" r="5"></circle><path d="M184.0 72.0 v-3.5 M188.0 79.5 l3 2 M180.0 79.5 l-3 2"></path></g><text x="199" y="81" font-size="9.5" font-weight="600" fill="var(--ink)">Model A</text><circle cx="296" cy="77" r="7" fill="var(--bad)"></circle><path d="M292.8 73.8 L299.2 80.2 M299.2 73.8 L292.8 80.2" stroke="var(--onbrand)" stroke-width="1.8" stroke-linecap="round"></path><rect x="167" y="104" width="145" height="34" rx="8" fill="var(--okq)" stroke="var(--ok)" stroke-width="1.5"></rect><g stroke="var(--ink)" stroke-width="1.3" fill="none"><rect x="178.0" y="115.0" width="9" height="9" rx="2.5"></rect><rect x="181.5" y="118.5" width="9" height="9" rx="2.5"></rect></g><text x="199" y="125" font-size="9.5" font-weight="600" fill="var(--ink)">Model B</text><circle cx="296" cy="121" r="7" fill="var(--ok)"></circle><path d="M292.2 121 L294.7 123.6 L300.1 118.0" fill="none" stroke="var(--onbrand)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path><rect x="167" y="148" width="145" height="34" rx="8" fill="var(--raise)" stroke="var(--line)" stroke-width="1"></rect><g stroke="var(--ink)" stroke-width="1.3" fill="none"><path d="M184.0 159.0 L190.0 165.0 L184.0 171.0 L178.0 165.0 Z"></path></g><circle cx="184.0" cy="165.0" r="1.8" fill="var(--ink)"></circle><text x="199" y="169" font-size="9.5" font-weight="600" fill="var(--ink)">Model C</text><circle cx="296" cy="165" r="7" fill="var(--line-strong)"></circle><text x="296" y="168.5" text-anchor="middle" font-size="10" font-weight="700" fill="var(--raise)">$</text><rect x="326" y="60" width="145" height="122" rx="10" fill="var(--raise)" stroke="var(--brand)" stroke-width="1.5"></rect><rect x="340" y="72" width="52" height="17" rx="8" fill="var(--okq)"></rect><circle cx="350" cy="80.5" r="3" fill="var(--ok)"></circle><text x="358" y="84" class="m" font-size="8" font-weight="700" fill="var(--ok)">LIVE</text><g stroke="var(--ink)" stroke-width="1.3" fill="none"><rect x="342.0" y="100.0" width="9" height="9" rx="2.5"></rect><rect x="345.5" y="103.5" width="9" height="9" rx="2.5"></rect></g><text x="364" y="111" font-size="12" font-weight="700" fill="var(--ink)">Model B</text><text x="340" y="131" font-size="8.5" fill="var(--mut)">serving your traffic</text><rect x="340" y="140" width="117" height="14" rx="7" fill="var(--okq)"></rect><text x="348" y="150" font-size="8" font-weight="600" fill="var(--ok)">quality holds</text><rect x="340" y="158" width="117" height="14" rx="7" fill="var(--brandq)"></rect><text x="348" y="168" font-size="8" font-weight="600" fill="var(--brand)">up to 24x lower cost</text><g fill="none" stroke="var(--line-strong)" stroke-width="1.3" stroke-dasharray="3 3"><path d="M155 112 H164"></path></g><path d="M314 112 H324" fill="none" stroke="var(--ok)" stroke-width="1.8"></path><rect x="8" y="206" width="463" height="52" rx="11" fill="var(--panel)" stroke="var(--line)" stroke-width="1.1"></rect><circle cx="34" cy="232" r="11" fill="var(--ok)"></circle><path d="M30.2 232 L32.7 234.6 L38.1 229.0" fill="none" stroke="var(--onbrand)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path><text x="56" y="228" font-size="11.5" font-weight="700" fill="var(--ink)">No manual benchmarking</text><text x="56" y="244" font-size="8.5" fill="var(--mut)">Understudy runs the trials, reads the results and switches for you</text></svg></div></div>
      </div>
      <div>
        <div class="vname"><span class="vtag">C</span>One lane lit</div>
        <div class="vnote">Three lanes, only one carrying traffic, and the caption says the lit one changes. It is the only version that draws the part people do not expect, which is that the winner keeps being re-decided.</div>
        <div class="stage"><div class="exhibit"><svg viewBox="0 0 480 278" width="100%" role="img" aria-label="Traffic arriving on the left, three candidate lanes with only the passing one lit, carrying on to the model currently serving."><text x="8" y="16" font-size="9" fill="var(--mut)">your traffic</text><rect x="8" y="30" width="74" height="9" rx="4.5" fill="var(--brandq)"></rect><circle cx="16" cy="34.5" r="3" fill="var(--brand)"></circle><rect x="8" y="46" width="74" height="9" rx="4.5" fill="var(--brandq)"></rect><circle cx="16" cy="50.5" r="3" fill="var(--brand)"></circle><rect x="8" y="62" width="74" height="9" rx="4.5" fill="var(--brandq)"></rect><circle cx="16" cy="66.5" r="3" fill="var(--brand)"></circle><rect x="8" y="78" width="74" height="9" rx="4.5" fill="var(--brandq)"></rect><circle cx="16" cy="82.5" r="3" fill="var(--brand)"></circle><path d="M86 58 C104 58 104 130 120 130" fill="none" stroke="var(--brand)" stroke-width="1.6"></path><rect x="126" y="56" width="214" height="44" rx="9" fill="var(--raise)" stroke="var(--line)" stroke-width="1.1"></rect><g stroke="var(--ink)" stroke-width="1.3" fill="none"><circle cx="146.0" cy="78.0" r="5"></circle><path d="M146.0 73.0 v-3.5 M150.0 80.5 l3 2 M142.0 80.5 l-3 2"></path></g><text x="162" y="75" font-size="10.5" font-weight="600" fill="var(--ink)">Model A</text><text x="162" y="88" font-size="8" fill="var(--mut)">misses the bar</text><circle cx="322" cy="78" r="8" fill="var(--bad)"></circle><path d="M318.8 74.8 L325.2 81.2 M325.2 74.8 L318.8 81.2" stroke="var(--onbrand)" stroke-width="1.8" stroke-linecap="round"></path><rect x="126" y="108" width="214" height="44" rx="9" fill="var(--okq)" stroke="var(--ok)" stroke-width="1.6"></rect><g stroke="var(--ink)" stroke-width="1.3" fill="none"><rect x="140.0" y="124.0" width="9" height="9" rx="2.5"></rect><rect x="143.5" y="127.5" width="9" height="9" rx="2.5"></rect></g><text x="162" y="127" font-size="10.5" font-weight="600" fill="var(--ink)">Model B</text><text x="162" y="140" font-size="8" fill="var(--mut)">clears it, and costs least</text><circle cx="322" cy="130" r="8" fill="var(--ok)"></circle><path d="M318.2 130 L320.7 132.6 L326.1 127.0" fill="none" stroke="var(--onbrand)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path><path d="M340 130 H380" fill="none" stroke="var(--ok)" stroke-width="2"></path><path d="M375 126 l5 4 -5 4" fill="none" stroke="var(--ok)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path><rect x="126" y="160" width="214" height="44" rx="9" fill="var(--raise)" stroke="var(--line)" stroke-width="1.1"></rect><g stroke="var(--ink)" stroke-width="1.3" fill="none"><path d="M146.0 176.0 L152.0 182.0 L146.0 188.0 L140.0 182.0 Z"></path></g><circle cx="146.0" cy="182.0" r="1.8" fill="var(--ink)"></circle><text x="162" y="179" font-size="10.5" font-weight="600" fill="var(--ink)">Model C</text><text x="162" y="192" font-size="8" fill="var(--mut)">costs more</text><circle cx="322" cy="182" r="8" fill="var(--line-strong)"></circle><text x="322" y="185.5" text-anchor="middle" font-size="10" font-weight="700" fill="var(--raise)">$</text><rect x="386" y="86" width="86" height="88" rx="10" fill="var(--raise)" stroke="var(--ok)" stroke-width="1.5"></rect><circle cx="400" cy="102" r="3" fill="var(--ok)"></circle><text x="408" y="105" class="m" font-size="8" font-weight="700" fill="var(--ok)">LIVE</text><g stroke="var(--ink)" stroke-width="1.3" fill="none"><rect x="398.0" y="118.0" width="9" height="9" rx="2.5"></rect><rect x="401.5" y="121.5" width="9" height="9" rx="2.5"></rect></g><text x="429" y="146" text-anchor="middle" font-size="9.5" font-weight="700" fill="var(--ink)">serving</text><text x="429" y="160" text-anchor="middle" font-size="9.5" font-weight="700" fill="var(--ink)">your traffic</text><rect x="8" y="214" width="464" height="50" rx="11" fill="var(--panel)" stroke="var(--line)" stroke-width="1.1"></rect><circle cx="34" cy="239" r="11" fill="var(--ok)"></circle><path d="M30.2 239 L32.7 241.6 L38.1 236.0" fill="none" stroke="var(--onbrand)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path><text x="56" y="235" font-size="11" font-weight="700" fill="var(--ink)">One lane stays lit, and it is never the same one for long</text><text x="56" y="251" font-size="8.5" fill="var(--mut)">the trial runs again on fresh calls, so a model that drifts loses the lane</text></svg></div></div>
      </div>
    </div>
  </div>
