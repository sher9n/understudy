# Routing. Without this the proxy refuses rather than pretending.
OPENROUTER_API_KEY=
ROUTING_FEE_PCT=1
ZDR_ONLY=true

# Money. Without these the wallet is read-only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STARTER_CREDIT_USD=1
TOPUP_AMOUNT_USD=20
TOPUP_THRESHOLD_USD=5
OBSERVE_PLAN_USD=49
EVAL_ALLOWANCE_USD=10

# What we keep
RETENTION_DAYS=30

# Measurement
EVAL_SAMPLE_SIZE=120
EVAL_MIN_RUNS=100
EVAL_FLOOR_MIN_PCT=3
EVAL_MAX_USD_PER_RUN=2

PORT=4600

# Where the app lives, and where its database file lives.
#
# PUBLIC_URL is the address shown to customers on Connect as the base URL to point their
# client at, so it has to be the address that actually reaches this app. Leave it blank on
# a host that hands the app its own domain and it is worked out from that.
PUBLIC_URL=
#
# DATA_DIR holds the SQLite file. On a host whose filesystem is wiped on every deploy this
# MUST point at a mounted volume, or every deploy starts from an empty database: no
# accounts, no keys, no traffic, no measurements.
DATA_DIR=data
#
# Session cookies are marked Secure automatically when PUBLIC_URL is https. Set this only
# to override that.
# SECURE_COOKIES=true
