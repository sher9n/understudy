# What we keep
RETENTION_DAYS=30

# Measurement
EVAL_SAMPLE_SIZE=120
EVAL_MIN_RUNS=100
EVAL_FLOOR_MIN_PCT=3
EVAL_MAX_USD_PER_RUN=2

PORT=4600
