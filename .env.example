# Routing. Without this the proxy refuses rather than pretending.
OPENROUTER_API_KEY=
ROUTING_FEE_PCT=1
ZDR_ONLY=true

# Money. Without these the wallet is read-only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STARTER_CREDIT_USD=1
TOPUP_AMOUNT_USD=20
TOPUP_THRESHOLD_USD=5
OBSERVE_PLAN_USD=49
EVAL_ALLOWANCE_USD=10

# What we keep
RETENTION_DAYS=30

# Measurement
EVAL_SAMPLE_SIZE=120
EVAL_MIN_RUNS=100
EVAL_FLOOR_MIN_PCT=3
EVAL_MAX_USD_PER_RUN=2
# How often a workspace measures itself until it chooses on Settings, in days. It has to be one
# of the choices Settings offers (0, 1, 5, 10, 30, 90); anything else falls back to 30.
MEASURE_EVERY_DAYS=30

PORT=4600

# Where the app lives, and where its database file lives.
#
# PUBLIC_URL is the address shown to customers on Connect as the base URL to point their
# client at, so it has to be the address that actually reaches this app. Leave it blank on
# a host that hands the app its own domain and it is worked out from that.
PUBLIC_URL=
#
# Postgres. Locally this is a database on your own machine; in production the platform
# supplies it. Everything lives here: accounts, keys, traffic, measurements, the ledger.
DATABASE_URL=postgresql://localhost:5432/understudy
#
# Session cookies are marked Secure automatically when PUBLIC_URL is https. Set this only
# to override that.
# SECURE_COOKIES=true

# Encrypts API keys at rest so a customer can be shown their own key again rather than a
# stub they cannot use. Generate with `openssl rand -hex 32`, and KEEP IT: change it and
# existing keys can no longer be shown, only replaced. Without it the app shows a prefix
# and offers to replace, which is less useful but never less safe.
KEY_SECRET=
