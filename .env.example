# Routing. Without this the proxy refuses rather than pretending.
OPENROUTER_API_KEY=
ROUTING_FEE_PCT=1
ZDR_ONLY=true

# Money. Without these the wallet is read-only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STARTER_CREDIT_USD=1
TOPUP_AMOUNT_USD=20
TOPUP_THRESHOLD_USD=5
TOPUP_MAX_PER_DAY=10
OBSERVE_PLAN_USD=49
EVAL_ALLOWANCE_USD=10
# On an https deployment, Stripe payments made in test mode never become balance, unless this
# says the deployment is for testing.
# ALLOW_TEST_PAYMENTS=false

# Email. Without a key, each email is printed to the log instead. Always sent from a docupath.ai
# address; CONTACT_TO is where the contact form goes.
RESEND_API_KEY=
EMAIL_FROM=Understudy <noreply@docupath.ai>
CONTACT_TO=
# Emails about a workspace's own events: on, and at most this many a day.
NOTIFY_ENABLED=true
NOTIFY_MAX_PER_DAY=10

# What a call sets aside before it is sent is the most it can cost. A request with no cap on its
# answer, to a model that publishes no longest answer, is sent capped at this many tokens.
HOLD_MAX_OUTPUT_TOKENS=32000
# A live streamed answer may go on while it keeps coming: this much silence at most, this long in all.
UPSTREAM_IDLE_MS=120000
UPSTREAM_STREAM_MAX_MS=1800000
# Which header names the address a request came from: x-real-ip behind Railway's edge, or xff-first
# once Railway's CDN sits in front.
CLIENT_IP_FROM=x-real-ip

# What we keep
RETENTION_DAYS=30

# Measurement
EVAL_MIN_RUNS=100
EVAL_FLOOR_MIN_PCT=3
# What one measurement may spend: at least EVAL_MAX_USD_PER_RUN, more for a workload worth more, never
# past EVAL_RUN_CAP_USD. One nobody asked for runs only when its expected saving pays for it within
# EVAL_PAYBACK_MONTHS.
EVAL_MAX_USD_PER_RUN=2
EVAL_RUN_CAP_USD=20
EVAL_PAYBACK_MONTHS=2
# The second look: at most this many cleared models are measured again on calls they have never seen.
EVAL_CONFIRM_TRIES=2
# The customer's own recorded answers are used as one of the bar's two.
EVAL_USE_RECORDED=true
# How new workloads switch in a workspace that has not chosen: ask, auto or off.
DEFAULT_OPTIMIZE_MODE=ask
# How often a workspace measures itself until it chooses on Settings, in days. It has to be one
# of the choices Settings offers (0, 1, 5, 10, 30, 90); anything else falls back to 30.
MEASURE_EVERY_DAYS=30

# Choosing which models to measure. Jev (TypeSafe's judging model) reads how well each model
# suits a workload and judges written answers. It is reached through OpenRouter with the key
# above, only through a provider that keeps nothing, and billed there. JEV_VIA=typesafe uses
# TypeSafe's own API and TYPESAFE_API_KEY instead; JEV_VIA=off leaves the model in
# EVAL_JUDGE_MODEL to judge alone. Everything else here has a default.
JEV_VIA=openrouter
TYPESAFE_API_KEY=
# Up to this many times the number of models measured to the end may be tried, this many run
# side by side, and every model answers this many calls before it can be dropped for speed.
EVAL_TRY_MULTIPLE=3
EVAL_PARALLEL_MODELS=5
EVAL_SCREEN_CALLS=3
# Ruled out: below this uptime at its best provider that keeps nothing; retiring within this many
# days; or thinking before every answer when answers are capped below this many tokens.
EVAL_MIN_UPTIME_PCT=99
EVAL_EXPIRY_DAYS=30
EVAL_THINKING_ROOM_TOKENS=4000
# How much slower than the customer's model a replacement may be, for "As fast as now" and
# "A little slower is fine", and the slack in milliseconds nobody would notice.
SPEED_SAME=1.2
SPEED_SLOWER_OK=1.5
SPEED_SLACK_MS=300
# How long each fact is trusted before it is read again, because models and providers change.
CATALOG_SYNC_HOURS=6
HEALTH_TTL_MIN=60
FIT_TTL_DAYS=14
ARENA_TTL_DAYS=7
# How long an answer already paid for is used again instead of paying for it twice, and how
# long a refusal is believed before the model is asked again.
REPLAY_REUSE_DAYS=14
REPLAY_FAILURE_REUSE_HOURS=6
JUDGE_CACHE_DAYS=14

# A switch starts on a share of the calls and grows while they hold up: the shares it passes
# through before all of them, and the hours it spends at each at least.
ROLLOUT_ENABLED=true
ROLLOUT_STAGES=0.05,0.25
ROLLOUT_STAGE_HOURS=2,12
# Reading a few of each strategy's live answers a day in the background, within a daily budget.
GRADE_ENABLED=true
GRADE_PER_ARM_PER_DAY=20
GRADE_BUDGET_USD_PER_DAY=0.25
# Marking a long, repeated instruction for caching on models that only cache what is marked.
CACHE_HINTS=true

PORT=4600

# Where the app lives, and where its database file lives.
#
# PUBLIC_URL is the address shown to customers on Connect as the base URL to point their
# client at, so it has to be the address that actually reaches this app. Leave it blank on
# a host that hands the app its own domain and it is worked out from that.
PUBLIC_URL=
#
# Postgres. Locally this is a database on your own machine; in production the platform
# supplies it. Everything lives here: accounts, keys, traffic, measurements, the ledger.
DATABASE_URL=postgresql://localhost:5432/understudy
#
# Session cookies are marked Secure automatically when PUBLIC_URL is https. Set this only
# to override that.
# SECURE_COOKIES=true

# Encrypts API keys at rest so a customer can be shown their own key again rather than a
# stub they cannot use. Generate with `openssl rand -hex 32`, and KEEP IT: change it and
# existing keys can no longer be shown, only replaced. Without it the app shows a prefix
# and offers to replace, which is less useful but never less safe.
KEY_SECRET=
