# Routing. Without this the proxy refuses rather than pretending.
OPENROUTER_API_KEY=
ROUTING_FEE_PCT=1
ZDR_ONLY=true

# Money. Without these the wallet is read-only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STARTER_CREDIT_USD=1
TOPUP_AMOUNT_USD=20
TOPUP_THRESHOLD_USD=5
OBSERVE_PLAN_USD=49
EVAL_ALLOWANCE_USD=10

# What we keep
RETENTION_DAYS=30

# Measurement
EVAL_SAMPLE_SIZE=120
EVAL_MIN_RUNS=100
EVAL_FLOOR_MIN_PCT=3
EVAL_MAX_USD_PER_RUN=2
# How often a workspace measures itself until it chooses on Settings, in days. It has to be one
# of the choices Settings offers (0, 1, 5, 10, 30, 90); anything else falls back to 30.
MEASURE_EVERY_DAYS=30

# Choosing which models to measure. Jev (TypeSafe's judging model) reads how well each model
# suits a workload and judges written answers. Without a key, the model in EVAL_JUDGE_MODEL
# judges alone and models are ranked without Jev's reading. Everything else here has a default.
TYPESAFE_API_KEY=
# Up to this many times the number of models measured to the end may be tried, this many run
# side by side, and every model answers this many calls before it can be dropped for speed.
EVAL_TRY_MULTIPLE=3
EVAL_PARALLEL_MODELS=5
EVAL_SCREEN_CALLS=3
# Ruled out: below this uptime at its best provider that keeps nothing; retiring within this many
# days; or thinking before every answer when answers are capped below this many tokens.
EVAL_MIN_UPTIME_PCT=99
EVAL_EXPIRY_DAYS=30
EVAL_THINKING_ROOM_TOKENS=4000
# How much slower than the customer's model a replacement may be, for "As fast as now" and
# "A little slower is fine", and the slack in milliseconds nobody would notice.
SPEED_SAME=1.2
SPEED_SLOWER_OK=1.5
SPEED_SLACK_MS=300
# How long each fact is trusted before it is read again, because models and providers change.
CATALOG_SYNC_HOURS=6
HEALTH_TTL_MIN=60
FIT_TTL_DAYS=14
ARENA_TTL_DAYS=7
# How long an answer already paid for is used again instead of paying for it twice, and how
# long a refusal is believed before the model is asked again.
REPLAY_REUSE_DAYS=14
REPLAY_FAILURE_REUSE_HOURS=6
JUDGE_CACHE_DAYS=14

PORT=4600

# Where the app lives, and where its database file lives.
#
# PUBLIC_URL is the address shown to customers on Connect as the base URL to point their
# client at, so it has to be the address that actually reaches this app. Leave it blank on
# a host that hands the app its own domain and it is worked out from that.
PUBLIC_URL=
#
# Postgres. Locally this is a database on your own machine; in production the platform
# supplies it. Everything lives here: accounts, keys, traffic, measurements, the ledger.
DATABASE_URL=postgresql://localhost:5432/understudy
#
# Session cookies are marked Secure automatically when PUBLIC_URL is https. Set this only
# to override that.
# SECURE_COOKIES=true

# Encrypts API keys at rest so a customer can be shown their own key again rather than a
# stub they cannot use. Generate with `openssl rand -hex 32`, and KEEP IT: change it and
# existing keys can no longer be shown, only replaced. Without it the app shows a prefix
# and offers to replace, which is less useful but never less safe.
KEY_SECRET=
